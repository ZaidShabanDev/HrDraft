{
  // Copy this file to appsettings.Local.json and fill it in.
  //
  // appsettings.Local.json is gitignored and excluded from publish output, so it is the one
  // place a real password can sit. appsettings.json is committed — never put one there.
  //
  // Loaded in every environment, which matters because `dotnet ef` does not read
  // launchSettings.json: an environment-specific file would leave migrations with no
  // connection string.

  "ConnectionStrings": {
    // TrustServerCertificate=True is needed for a SQL Server with a self-signed certificate.
    // The driver encrypts by default and will otherwise refuse to connect.
    "HrDraft": "Data Source=YOUR-HOST\\YOUR-INSTANCE;Initial Catalog=HrDraft;User Id=hrdraft_app;Password=***;TrustServerCertificate=True"
  },

  "HrDraft": {
    // Creates the first administrator on startup, and only while the Users table is empty.
    // Delete this section once you can sign in.
    "BootstrapAdmin": {
      "Email": "you@example.com",
      "Password": "***",
      "DisplayName": "Your Name"
    }
  }
}
